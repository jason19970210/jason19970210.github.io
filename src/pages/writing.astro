---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { site, mediumPosts } from '../data/site';
import { allPosts, fmtDate } from '../lib';

const posts = await allPosts();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
---
<Base title="Writing" description={site.writingIntro}>
  <div class="page-head"><div class="wrap">
    <h1>Writing</h1>
    <p class="lede">{site.writingIntro}</p>
  </div></div>
  <div class="page-body"><div class="wrap">
    <h2 class="subhead first" id="medium">More on Medium</h2>
    <p class="muted">Technical write-ups that live on <a href={site.medium.href} rel="me noopener">Medium</a>.</p>
    <ul class="post-list">
      {mediumPosts.map((m) => (
        <li>
          <a class="row ext" href={m.href} rel="noopener">
            <time datetime={m.date}>{fmtDate(new Date(m.date))}</time>
            <span class="t">{m.title}</span>
            <span class="cat">medium.com <span aria-hidden="true">&#8599;</span><span class="sr-only"> (external site)</span></span>
          </a>
        </li>
      ))}
    </ul>
    <h2 class="subhead" id="on-this-site">On this site</h2>
    {years.map((y) => (
      <>
        <h2 class="year-label">{y}</h2>
        <PostList posts={posts.filter((p) => p.data.date.getUTCFullYear() === y)} />
      </>
    ))}
  </div></div>
</Base>
