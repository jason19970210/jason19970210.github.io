---
import Base from '../layouts/Base.astro';
import { publication, thesis, patents, awards } from '../data/site';
---
<Base title="Publications & Awards" description="Publications, thesis, Taiwan patents, and awards of Jason (Yi-Cheih) Hsu on vehicle forensics and post-quantum cryptography.">
  <div class="page-head"><div class="wrap">
    <p class="eyebrow">Publications &amp; Awards</p>
    <h1>Publications &amp; Awards</h1>
  </div></div>
  <div class="page-body"><div class="wrap">
    <div class="pub">
      <p class="kind">Publication</p>
      <p>{publication.authors} <span class="title">&ldquo;{publication.title}&rdquo;</span> {publication.venue}</p>
      <p><a href={publication.doi} rel="noopener">{publication.doi}</a></p>
    </div>
    <div class="pub">
      <p class="kind">Thesis</p>
      <p><span class="title">&ldquo;{thesis.title}&rdquo;</span> {thesis.detail}</p>
    </div>
    <div class="pub">
      <p class="kind">Patents (Taiwan, co-inventor)</p>
      <table class="pub-table">
        <caption class="sr-only">Taiwan patents, co-inventor</caption>
        <tbody>
          {patents.map((p) => (
            <tr><th scope="row"><a href={p.href} rel="noopener">{p.id}</a><span class="sr-only"> (Google Patents, external site)</span></th><td>{p.title}{p.year && ` (${p.year})`}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <h2 class="subhead" id="awards">Awards</h2>
    <table class="pub-table awards">
      <caption class="sr-only">Awards, newest first</caption>
      <tbody>
        {awards.map((a) => (<tr><th scope="row">{a.year}</th><td>{a.title}</td></tr>))}
      </tbody>
    </table>
  </div></div>
</Base>
