---
import Base from '../layouts/Base.astro';
import { site, stack, jobs, projects, aboutIntro, aboutPoints } from '../data/site';

const featuredJobs = jobs.slice(0, 3);
const featuredProjects = projects.slice(0, 3);
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow"><b>Taipei</b> / firmware, OTA, backend, <span class="nb">device-to-cloud</span></p>
        <h1>{site.name}</h1>
        <p class="positioning">{site.positioning}</p>
        <p class="intro">{site.intro}</p>
        <div class="btn-row">
          <a class="btn primary" href={site.cv} download>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0l-4.5-4.5M12 15l4.5-4.5M4 20h16" /></svg>
            Download CV
          </a>
          <a class="btn" href={`mailto:${site.email}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
            Email
          </a>
        </div>
        <p class="elsewhere">Also on <a href={site.linkedin.href} rel="me noopener">LinkedIn</a>, <a href={site.github.href} rel="me noopener">GitHub</a>, <a href={site.medium.href} rel="me noopener">Medium</a>.</p>
      </div>
      <div class="stack-wrap">
        <p class="stack-cap" id="stack-cap">Boot order of the stack I work on. Each layer links to the role behind it.</p>
        <ol class="stack" aria-labelledby="stack-cap">
          {stack.map((s, i) => (
            <li style={`--i:${i}`}>
              <a href={s.href}>
                <span class="n">{String(i + 1).padStart(2, '0')}</span>
                <span class="l">{s.layer}</span>
                <span class="d">{s.detail}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="block about" id="about" aria-labelledby="about-h">
    <div class="wrap about-grid">
      <h2 id="about-h">About</h2>
      <div class="about-copy">
        <p class="about-intro">{aboutIntro}</p>
        <ul class="points">{aboutPoints.map((a) => <li><strong>{a.lead}</strong> {a.text}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="exp-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="exp-h">Experience</h2>
        <span class="more-links"><a class="more" href="/experience/">Full experience, education and skills</a><a class="more" href="/experience/#community">Community &amp; volunteering</a></span>
      </div>
      <ol class="roles">
        {featuredJobs.map((j) => (
          <li class="role">
            <h3 class="t"><a href={`/experience/#${j.id}`}>{j.title}</a></h3>
            <p class="c">{j.company}</p>
            <p class="where">{j.period} &middot; {j.place}</p>
            <ul>{j.bullets.slice(0, 3).map((b) => <li>{b}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="block" aria-labelledby="proj-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="proj-h">Projects</h2>
        <a class="more" href="/projects/">All projects</a>
      </div>
      <div class="cards three">
        {featuredProjects.map((p) => (
          <article class="card">
            <h3><a href={`/projects/#${p.slug}`}>{p.title}</a></h3>
            <p>{p.summary}</p>
            <ul class="tags" aria-label="Technologies">{p.tags.slice(0, 5).map((t) => <li>{t}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

</Base>
