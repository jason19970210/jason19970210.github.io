---
import Base from '../layouts/Base.astro';
import JobItem from '../components/JobItem.astro';
import { jobs, community, talks, earlier, education, certification, skills } from '../data/site';
---
<Base title="Experience" description="Experience of Jason (Yi-Cheih) Hsu: OTA and firmware at Airgain, U-Boot and L2/L3 switch software at Senao, a device-to-cloud platform at Morelink, and DFIR at Skynet.">
  <div class="page-head"><div class="wrap">
    <p class="eyebrow">Experience</p>
    <h1>Where I have worked</h1>
  </div></div>
  <div class="page-body"><div class="wrap">
    <h2 class="subhead first">Work</h2>
    <ol class="roles">{jobs.map((j) => <JobItem job={j} />)}</ol>
    <p class="muted"><strong>Earlier:</strong> {earlier}</p>

    <h2 class="subhead" id="community">Community &amp; Volunteering</h2>
    <ul class="plain">{community.map((c) => <li>{c}</li>)}</ul>
    <h3 class="subsub">Talks &amp; Teaching</h3>
    <ul class="plain">{talks.map((c) => <li>{c}</li>)}</ul>

    <h2 class="subhead">Education</h2>
    <ol class="roles">
      {education.map((e) => (
        <li class="role">
          <div class="role-head">
            <h3><span class="t">{e.degree}</span>, <span class="c">{e.school}</span></h3>
            <p class="when">{e.period}</p>
          </div>
          <p class="where">{e.place}</p>
          <p class="note">{e.note}</p>
        </li>
      ))}
    </ol>
    <h2 class="subhead">Certification</h2>
    <p>{certification}</p>

    <h2 class="subhead">Skills</h2>
    <dl class="deflist">
      {skills.map((s) => (<><dt>{s.group}</dt><dd>{s.items}</dd></>))}
    </dl>
  </div></div>
</Base>
