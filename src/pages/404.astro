---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist.">
  <div class="wrap notfound">
    <p class="eyebrow"><span class="code">404</span></p>
    <h1>Page not found</h1>
    <p class="lede">The page you asked for is not here. Old blog tag and archive pages were retired; posts live under Writing.</p>
    <div class="btn-row"><a class="btn primary" href="/writing/">Go to Writing</a><a class="btn" href="/">Home</a></div>
  </div>
</Base>
