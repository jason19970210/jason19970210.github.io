---
import type { Job } from '../data/site';
const { job } = Astro.props as { job: Job };
---
<li class="role" id={job.id}>
  <div class="role-head">
    <h3><span class="t">{job.title}</span>, <span class="c">{job.company}</span></h3>
    <p class="when">{job.period}</p>
  </div>
  <p class="where">{job.place}</p>
  <ul>{job.bullets.map((b) => <li>{b}</li>)}</ul>
</li>
