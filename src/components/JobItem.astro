---
import type { Job } from '../data/site';
const { job } = Astro.props as { job: Job };
---
<li class="job">
  <div class="when"><span>{job.period}</span><span>{job.place}</span></div>
  <div>
    <h3>{job.title}</h3>
    <p class="co">{job.company}</p>
    <ul>{job.bullets.map((b) => <li>{b}</li>)}</ul>
  </div>
</li>
