---
import type { Job } from '../data/site';
const { job } = Astro.props as { job: Job };
---
<li class="role" id={job.id}>
  <h3 class="t">{job.title}</h3>
  <p class="c">{job.company}</p>
  <p class="where">{job.period} &middot; {job.place}</p>
  <ul>{job.bullets.map((b) => <li>{b}</li>)}</ul>
</li>
